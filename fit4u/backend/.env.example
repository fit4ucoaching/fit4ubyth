# ═══════════════════════════════════════════════════════════════════════════
# Fit4U by TH — Variables d'environnement (backend)
# Miroir exact de backend/src/config/env.ts — toute variable ajoutée au
# schéma Zod doit être ajoutée ici, et inversement.
# ═══════════════════════════════════════════════════════════════════════════

# --- Runtime ---
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# --- Base de données ---
DATABASE_URL=postgresql://fit4u:fit4u@localhost:5432/fit4u_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth JWT ---
JWT_SECRET=change-me-min-32-characters-long
JWT_REFRESH_SECRET=change-me-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Paiements ---
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Boutique (cache local Shopify) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Teddy AI ---
OPENAI_API_KEY=

# --- Email (SMTP) ---
EMAIL_FROM=no-reply@fit4u.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Rate limiting / sécurité ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_BLOCK_DURATION_S=900

# --- Observabilité ---
LOG_LEVEL=info
