{
  "name": "fit4u",
  "private": true,
  "version": "0.1.0",
  "description": "Fit4U by TH — Plateforme SaaS Premium (Fitness, Nutrition, Coach IA Teddy)",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter @fit4u/mobile start",
    "dev:web": "pnpm --filter @fit4u/web dev",
    "dev:admin": "pnpm --filter @fit4u/admin dev",
    "dev:backend": "pnpm --filter @fit4u/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^9.5.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "tsx": "^4.16.0",
    "@prisma/client": "^5.17.0",
    "prisma": "^5.17.0"
  }
}
