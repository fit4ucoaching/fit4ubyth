// ═══════════════════════════════════════════════════════════════════════════
// Fit4U by TH — Schéma Prisma canonique (Master Prompt Volume 2/8)
// Database Architect : PostgreSQL 16+ / Prisma ORM
//
// CONVENTIONS GLOBALES (voir docs/DATABASE_ARCHITECTURE.md pour le détail) :
//   • Toutes les tables : id UUID (gen_random_uuid()) en clé primaire
//   • Toutes les tables : createdAt / updatedAt en TIMESTAMPTZ (UTC)
//   • Tables métier      : deletedAt (soft delete) — jamais de suppression physique
//   • Tables de log/jonction/historique : append-only, pas de soft delete
//   • Nommage : tables snake_case (@@map), modèles PascalCase,
//               colonnes camelCase (@map quand nécessaire)
//   • 12 domaines fonctionnels, dans l'ordre du Master Prompt Volume 2
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS GLOBAUX
// ═══════════════════════════════════════════════════════════════════════════

/// Statut du compte utilisateur.
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

/// Palier d'abonnement — la vérité métier finale reste `VipAccess` pour VIP.
enum SubscriptionType {
  FREE
  PREMIUM
  PRO
  VIP
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  PERFORMANCE
  ENDURANCE
  HYROX
  RUNNING
  FOOTBALL
  MOBILITY
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EquipmentType {
  BODYWEIGHT
  DUMBBELLS
  BARBELL
  MACHINE
  RESISTANCE_BAND
  KETTLEBELL
  CARDIO
  OTHER
}

enum NotificationType {
  PUSH
  EMAIL
  IN_APP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ── Enums complémentaires (nécessaires à la cohérence référentielle du schéma,
//    non exhaustivement listés dans le Master Prompt mais requis pour éviter
//    tout champ libre non contrôlé sur un statut métier) ────────────────────

enum DeviceOS {
  IOS
  ANDROID
  WEB
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum GroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum PostVisibility {
