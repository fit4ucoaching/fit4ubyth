}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

enum AIMessageRole {
  USER
  TEDDY
  SYSTEM
}

enum AIPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  EXPIRED
}

enum RewardType {
  BADGE_UNLOCK
  DISCOUNT_CODE
  FREE_PRODUCT
