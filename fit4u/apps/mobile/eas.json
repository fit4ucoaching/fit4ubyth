{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1" },
      "ios": { "resourceClass": "m-medium" },
      "android": { "resourceClass": "medium" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.fit4u.app/api/v1" },
      "ios": { "resourceClass": "m-medium" },
      "android": { "resourceClass": "medium", "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.fit4u.app/api/v1" },
      "ios": { "resourceClass": "m-medium" },
      "android": { "resourceClass": "medium", "buildType": "app-bundle" }
    }
  },
  "submit": {
    "staging": {
      "ios": {}
    },
    "production": {
      "ios": {},
      "android": { "track": "production" }
    }
  }
}
